{
  "name": "todo-app",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:frontend": "npm run dev --workspace=@todo-app/frontend",
    "dev:backend": "npm run dev --workspace=@todo-app/backend",
    "dev": "npm run dev:backend & npm run dev:frontend",
    "build:frontend": "npm run build --workspace=@todo-app/frontend",
    "build:backend": "npm run build --workspace=@todo-app/backend",
    "build": "npm run build:backend && npm run build:frontend",
    "lint": "npm run lint --workspaces --if-present",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,css,scss,md}\""
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.0.0",
    "prettier": "^3.0.0",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "@nestjs/config": "^12.0.0"
  }
}
